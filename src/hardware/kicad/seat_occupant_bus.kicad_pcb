(kicad_pcb (version 20240108) (host pcbnew)
  (general (thickness 1.6)
    (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user "Edge.Cuts"))
  )
  (setup
    (clear_class "Logic_Control" (clearance 0.25) (trace_width 0.25))
    ;; COMPLIANCE: Continuous 0.5mm Parallel Guard Ground Tracks Shielding Seat Safety Sensors
    (clearance_class "Bilateral_Guard_Ring" (clearance 0.5) (trace_width 0.50))
  )

  (net 0 "")
  (net 1 "VCC_5V_ISO")
  (net 2 "GND_GUARD_SHIELD")
  (net 3 "Weight_Classification_Load_Cell")
  (net 4 "Harness_Buckle_Continuity_Sig")
  (net 5 "Muxed_Occupant_Data_Out")

  ;; --- Component Matrix Placements ---
  
  ;; U1: Occupant Weight & Restraint Signal Conditioner (GM Fleet Safety Verification Gate)
  (module "Housings_SOIC:SOIC-8_3.9x4.9mm_Pitch1.27mm" (layer "F.Cu") (at 45.0 45.0)
    (pad "1" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 1 "VCC_5V_ISO"))
    (pad "2" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 3 "Weight_Classification_Load_Cell"))
    (pad "3" smd rect (at 0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 4 "Harness_Buckle_Continuity_Sig"))
    (pad "4" smd rect (at 1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD")) ;; Guard Track Left
    (pad "5" smd rect (at 1.905 2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD"))  ;; Guard Track Right
    (pad "8" smd rect (at -1.905 2.7) (size 0.6 1.5) (layers "F.Cu") (net 5 "Muxed_Occupant_Data_Out"))
  )
)
