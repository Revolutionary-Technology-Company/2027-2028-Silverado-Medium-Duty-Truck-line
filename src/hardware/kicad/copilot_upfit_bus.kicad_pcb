(kicad_pcb (version 20240108) (host pcbnew)
  (general (thickness 1.6)
    (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user "Edge.Cuts"))
  )
  (setup
    (clearance_class "Logic_Control_Bus" (clearance 0.25) (trace_width 0.25))
    ;; COMPLIANCE: Continuous 0.5mm Parallel Guard Ground Tracks Shielding Co-Pilot Upfit Bus
    (clearance_class "Bilateral_Guard_Ring" (clearance 0.5) (trace_width 0.50))
    ;; COMPLIANCE: Rule #1 Thick 3oz Copper Trace Width Parameters for High-Draw Solenoid Drivers
    (clearance_class "Heavy_3oz_Solenoid_Bus" (clearance 2.0) (trace_width 3.00))
  )

  (net 0 "")
  (net 1 "VCC_12V_AVIONICS")
  (net 2 "GND_GUARD_SHIELD")
  (net 3 "Upfit_Command_Data_MOSI")
  (net 4 "Upfit_Command_Data_SCK")
  (net 5 "Hydraulic_Pump_Trigger_Gate")
  (net 6 "Strobe_Relay_Trigger_Gate")

  ;; --- Component Matrix Placements ---
  
  ;; U1: 16-State Co-Pilot Matrix Multi-Mux Gateway (RT Custom Industrial Control Processor)
  (module "Housings_SOIC:SOIC-16_3.9x9.9mm_Pitch1.27mm" (layer "F.Cu") (at 50.0 50.0)
    (pad "1" smd rect (at -4.445 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 1 "VCC_12V_AVIONICS"))
    (pad "2" smd rect (at -3.175 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 3 "Upfit_Command_Data_MOSI"))
    (pad "3" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 4 "Upfit_Command_Data_SCK"))
    (pad "4" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD")) ;; Guard Line Left
    (pad "5" smd rect (at 0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD"))  ;; Guard Line Right
    (pad "15" smd rect (at -3.175 2.7) (size 0.6 1.5) (layers "F.Cu") (net 5 "Hydraulic_Pump_Trigger_Gate"))
    (pad "16" smd rect (at -4.445 2.7) (size 0.6 1.5) (layers "F.Cu") (net 6 "Strobe_Relay_Trigger_Gate"))
    (net_class "Heavy_3oz_Solenoid_Bus" (pins "15" "16"))
  )
)
