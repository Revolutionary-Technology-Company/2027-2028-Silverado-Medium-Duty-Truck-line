(kicad_pcb (version 20240108) (host pcbnew)
  (general (thickness 2.4) ;; Ruggedized thick board configuration for commercial fleet use
    (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user "Edge.Cuts"))
  )
  (setup
    (clearance_class "Logic_Control" (clearance 0.25) (trace_width 0.25))
    ;; COMPLIANCE: Continuous 0.5mm Parallel Guard Ground Tracks Shielding Leveling Sensor Buses
    (clearance_class "Bilateral_Guard_Ring" (clearance 0.5) (trace_width 0.50))
    ;; COMPLIANCE: Rule #1 Thick 3oz Copper Trace Width Parameters for High-Draw Compressor Pump Relays
    (clearance_class "Heavy_3oz_Pump_Bus" (clearance 4.0) (trace_width 4.50))
  )

  (net 0 "")
  (net 1 "VCC_12V_AVIONICS")
  (net 2 "GND_GUARD_SHIELD")
  (net 3 "Lift_Ram_Solenoid_Inflate")
  (net 4 "Lift_Ram_Solenoid_Deflate")
  (net 5 "Pump_Compressor_Actuate_12V")
  (net 6 "Level_Sensor_Feedback_Bus")

  ;; --- Component Matrix Placements ---
  
  ;; U1: Octal Solenoid Valve Driver Module (GM Fleet Industrial Levelling Controller)
  (module "Housings_SOIC:SOIC-16_3.9x9.9mm_Pitch1.27mm" (layer "F.Cu") (at 45.0 45.0)
    (pad "1" smd rect (at -4.445 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 1 "VCC_12V_AVIONICS"))
    (pad "2" smd rect (at -3.175 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 3 "Lift_Ram_Solenoid_Inflate"))
    (pad "3" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 4 "Lift_Ram_Solenoid_Deflate"))
    (pad "4" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD")) ;; Guard Line Left
    (pad "5" smd rect (at 0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD"))  ;; Guard Line Right
    (pad "15" smd rect (at -3.175 2.7) (size 0.6 1.5) (layers "F.Cu") (net 5 "Pump_Compressor_Actuate_12V"))
    (pad "16" smd rect (at -4.445 2.7) (size 0.6 1.5) (layers "F.Cu") (net 6 "Level_Sensor_Feedback_Bus"))
    (net_class "Heavy_3oz_Pump_Bus" (pins "15"))
  )
)
