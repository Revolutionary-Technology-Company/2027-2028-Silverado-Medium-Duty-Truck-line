(kicad_pcb (version 20240108) (host pcbnew)
  (general (thickness 1.6)
    (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (44 "Edge.Cuts" user "Edge.Cuts"))
  )
  (setup
    (clearance_class "Logic_Control" (clearance 0.25) (trace_width 0.25))
    ;; COMPLIANCE: Continuous 0.5mm Parallel Guard Ground Tracks Shielding Over-Cab Lightbar Switching
    (clearance_class "Bilateral_Guard_Ring" (clearance 0.5) (trace_width 0.50))
    (clearance_class "High_Amperage_Light_Rail" (clearance 1.2) (trace_width 1.50))
  )

  (net 0 "")
  (net 1 "VCC_12V_AVIONICS")
  (net 2 "GND_GUARD_SHIELD")
  (net 3 "Lightbar_Gate_Trigger_PWM")
  (net 4 "Roof_Lightbar_Power_Anode")
  (net 5 "Roof_Lightbar_Power_Cathode")

  ;; --- Component Matrix Placements ---
  
  ;; U1: Solid-State Constant-Current Power Switch Driver (Tactical Roof Lightbar Gate Relay)
  (module "Housings_SOIC:SOIC-8_3.9x4.9mm_Pitch1.27mm" (layer "F.Cu") (at 50.0 50.0)
    (pad "1" smd rect (at -1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 1 "VCC_12V_AVIONICS"))
    (pad "2" smd rect (at -0.635 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 3 "Lightbar_Gate_Trigger_PWM"))
    (pad "4" smd rect (at 1.905 -2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD")) ;; Guard Track Left
    (pad "5" smd rect (at 1.905 2.7) (size 0.6 1.5) (layers "F.Cu") (net 2 "GND_GUARD_SHIELD"))  ;; Guard Track Right
    (pad "6" smd rect (at 0.635 2.7) (size 0.6 1.5) (layers "F.Cu") (net 4 "Roof_Lightbar_Power_Anode"))
    (pad "7" smd rect (at -0.635 2.7) (size 0.6 1.5) (layers "F.Cu") (net 5 "Roof_Lightbar_Power_Cathode"))
    (net_class "High_Amperage_Light_Rail" (pins "6" "7"))
  )
)
